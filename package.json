{
    "name": "sheet-password-removal",
    "version": "1.0.0",
    "description": "Remove passwords from Excel spreadsheets",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "sheet-unlock": "dist/index.js"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "tui": "node dist/index.js",
        "build:bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/sea-bundle.cjs",
        "build:exe": "npm run build && npm run build:bundle && node --experimental-sea-config sea-config.json && powershell -ExecutionPolicy Bypass -File scripts/build-exe.ps1",
        "postinstall": "npm run build"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.7",
        "@types/node": "^20.0.0",
        "esbuild": "^0.21.0",
        "postject": "^1.0.0-alpha.6",
        "typescript": "^5.0.0"
    },
    "dependencies": {
        "adm-zip": "^0.5.10"
    }
}